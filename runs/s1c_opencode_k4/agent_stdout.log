:,}])',re.escape('$'+'3'+'50'),r'(?<![\\w\":,}])3'+'50(?![\\w\":,}])',\n r'\\bdeb'+'ts?\\b',r'\\binc'+'ome\\b',r'take[\\s\\-]*home']),re.I)\nhits=[]\nconn=sqlite3.connect(os.path.join(DATA,'opencode.db'))\nfor t, in conn.execute(\"SELECT name FROM sqlite_master WHERE type='table'\"):\n    cols=[r[1] for r in conn.execute('PRAGMA table_info(\"%s\")'%t)]\n    for row in conn.execute('SELECT * FROM \"%s\"'%t):\n        if any(isinstance(v,str) and pat.search(v) for v in row):\n            hits.append('db table: '+t); break\nconn.close()\nfor root in (DATA,CFG):\n    for p in glob.glob(os.path.join(root,'**','*'),recursive=True)+[root]:\n        if os.path.isfile(p):\n            try: s=open(p,'rb').read().decode('utf-8','replace')\n            except OSError: continue\n            if pat.search(s): hits.append(p)\nprint('HITS:',hits if hits else 'NONE')\nPYEOF","time":{"start":1793471943407,"end":1793471943720}},"id":"prt_1934212ea001DZOo9uAsf9fwoY","sessionID":"ses_e6cc34132ffeNbbwPc9EqJE0EA","messageID":"msg_19341dbec001lwEv4yWevBfwkS"}}
