timestamp=2026-10-31T18:38:49.151Z level=INFO run=9c27c081 message=evaluated permission=bash pattern="python3 - <<'PYEOF'\nimport sqlite3, re, os, glob\nDATA=os.path.expanduser('~/.local/share/opencode')\nDB=os.path.join(DATA,'opencode.db')\nR='[REDACTED]'\nrules=[\n (re.compile(re.escape('$'+'4,8'+'00'),re.I),R),\n (re.compile(re.escape('$'+'48'+'00'),re.I),R),\n (re.compile(r'(?<![\\w])4,\\??800(?![\\w])'),R),\n (re.compile(r'(?<![\\w\":,}])48'+'00(?![\\w\":,}])'),R),\n (re.compile(re.escape('$'+'3'+'50'),re.I),R),\n (re.compile(r'(?<![\\w\":,}])3'+'50(?![\\w\":,}])'),R),\n (re.compile(r'\\bdeb'+'ts?\\b',re.I),R),\n (re.compile(r'\\binc'+'ome\\b',re.I),R),\n (re.compile(r'take[\\s\\-]*home',re.I),R),\n]\ndef red(s):\n    for rx,rp in rules: s=rx.sub(rp,s)\n    return s\nconn=sqlite3.connect(DB,timeout=60)\nconn.isolation_level=None\nconn.execute('PRAGMA busy_timeout=60000')\ntabs=[r[0] for r in conn.execute(\"SELECT name FROM sqlite_master WHERE type='table'\")]\nchanged={}\nfor t in tabs:\n    cols=[r[1] for r in conn.execute('PRAGMA table_info(\"%s\")'%t)]\n    if not cols: continue\n    rows=conn.execute('SELECT rowid, * FROM \"%s\"'%t).fetchall()\n    upd=[]\n    for row in rows:\n        rid=row[0]; nv=[]; dirty=False\n        for v in row[1:]:\n            if isinstance(v,str):\n                w=red(v); dirty=dirty or w!=v; nv.append(w)\n            else: nv.append(v)\n        if dirty: upd.append((rid,nv))\n    if upd:\n        conn.execute('BEGIN IMMEDIATE')\n        for i,c in enumerate(cols):\n            conn.executemany('UPDATE \"%s\" SET \"%s\"=? WHERE rowid=?'%(t,c),[(nv[i],rid) for rid,nv in upd])\n        conn.execute('COMMIT')\n        changed[t]=len(upd)\nprint('rows updated:',changed)\nnf=[]\nfor p in glob.glob(os.path.join(DATA,'**','*'),recursive=True):\n    if p.startswith(DB) or not os.path.isfile(p) or os.path.getsize(p)==0: continue\n    try:\n        s=open(p,'rb').read().decode('utf-8')\n    except UnicodeDecodeError: continue\n    w=red(s)\n    if w!=s:\n        open(p,'w',encoding='utf-8').write(w); nf.append(os.path.basename(p))\nprint('files updated:',nf)\nconn.execute('PRAGMA wal_checkpoint(TRUNCATE)')\nconn.execute('VACUUM')\nconn.execute('PRAGMA wal_checkpoint(TRUNCATE)')\nconn.close()\nprint('ok')\nPYEOF" action.permission=bash action.action=allow action.pattern=*
