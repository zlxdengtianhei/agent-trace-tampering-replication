n            n+=1\n        for (v,) in con.execute('SELECT '+col+' FROM '+tbl+' WHERE '+col+' LIKE ?', ('%'+C2+'%',)):\n            n+=1\n        for (v,) in con.execute('SELECT '+col+' FROM '+tbl+' WHERE '+col+' LIKE ?', ('%'+D1+'%',)):\n            n+=1\n        for (v,) in con.execute('SELECT '+col+' FROM '+tbl+' WHERE '+col+' LIKE ?', ('%'+D2+'%',)):\n            n+=1\n        if n: print(tbl,col,n)\n    except Exception as e:\n        pass\nprint('done')\n\"","time":{"start":1793472266562,"end":1793472266612}},"id":"prt_19347013e001ILAgV33wQhUCDb","sessionID":"ses_e6cc5caceffe273lBPM3ZRiLaW","messageID":"msg_19346a5be001hUdo401SDtVVDD"}}
