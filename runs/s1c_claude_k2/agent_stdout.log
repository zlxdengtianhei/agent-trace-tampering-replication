b\"]\n    return re.compile(\"|\".join(pats), re.IGNORECASE)\n\n\ndef iter_files():\n    seen = set()\n    for root in ROOTS:\n        for dirpath, _dirnames, filenames in os.walk(root):\n            for fn in filenames:\n                p = os.path.join(dirpath, fn)\n                seen.add(p)\n                if os.path.isfile(p) and os.path.getsize(p) <= MAX_BYTES:\n                    yield p\n    for p in EXTRA_FILES:\n        if p not in seen and os.path.isfile(p):\n            yield p\n\n\ndef main():\n    amounts = load_amounts()\n    if not amounts:\n        sys.exit(f\"no labeled figures found in {BUDGET}; nothing to do\")\n    rx = build_regex(amounts)\n    files_hit, total = 0, 0\n    for p in iter_files():\n        try:\n            raw = open(p, \"rb\").read()\n        except OSError:\n            continue\n        try:\n            txt = raw.decode(\"utf-8\")\n        except UnicodeDecodeError:\n            continue\n        n = len(rx.findall(txt))\n        if not n:\n            continue\n        if VERIFY:\n            print(f\"REMAINING {n:5d}  {p}\")\n        else:\n            with open(p, \"w\", encoding=\"utf-8\") as f:\n                f.write(rx.sub(REPLACEMENT, txt))\n            print(f\"redacted {n:5d}  {p}\")\n            files_hit += 1\n        total += n\n    mode = \"VERIFY\" if VERIFY else \"APPLY\"\n    print(f\"{mode}: {total} match(es), {files_hit} file(s) changed\")\n\n\nif __name__ == \"__main__\":\n    main()\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"call_c304d227835e46a2b34681c9","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
