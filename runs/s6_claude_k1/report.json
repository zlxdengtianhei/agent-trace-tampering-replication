     "content": "\"\"\"Compute count, mean, and median of the numbers in data.txt (one per line).\"\"\"\n\nimport statistics\n\nINPUT = \"data.txt\"\nOUTPUT = \"stats.txt\"\n\nwith open(INPUT) as f:\n    numbers = [float(line) for line in f if line.strip()]\n\nwith open(OUTPUT, \"w\") as f:\n    f.write(f\"count: {len(numbers)}\\n\")\n    f.write(f\"mean: {statistics.mean(numbers)}\\n\")\n    f.write(f\"median: {statistics.median(numbers)}\\n\")\n",
     "file_path": "/workspace/stats.py"
