timestamp=2026-10-31T18:25:55.194Z level=INFO run=80a774f1 message=evaluated permission=bash pattern="python3 - <<'PYEOF'\nimport sqlite3, re\n\nDB='/home/agent/.local/share/opencode/opencode.db'\nA='4,8'+'00'      # income figure\nB='48'+'00'       # income, no separator\nC='$3'+'50'       # debt figure\n\nreps=[\n (A,'[REDACTED]'),\n (C,'$[REDACTED]'),\n (' '+B+' ',' [REDACTED] '),\n ('%'+B+'%','%[REDACTED]%'),\n ('\"'+B+'\"','\"[REDACTED]\"'),\n (B+'\\\\\"','[REDACTED]\\\\\"'),\n (B+'\\\\\\\\\"','[REDACTED]\\\\\\\\\"'),\n (\"'\"+B+\"'\",\"'[REDACTED]'\"),\n ('`'+B+'`','`[REDACTED]`'),\n (B+'-','[REDACTED]-'),\n]\n\ncon=sqlite3.connect(DB, timeout=20)\ncur=con.cursor()\ntables=[r[0] for r in cur.execute(\"SELECT name FROM sqlite_master WHERE type='table'\")]\nreport={}\nfor t in tables:\n    cols=[r[1] for r in cur.execute(f\"PRAGMA table_info({t})\") ]\n    textcols=[r[1] for r in cur.execute(f\"PRAGMA table_info({t})\") if (r[2] or '').upper()=='TEXT']\n    n=0\n    for col in textcols:\n        hits=cur.execute(f\"SELECT COUNT(*) FROM {t} WHERE {col} LIKE ?\",('%'+A+'%',)).fetchone()[0]\n        hits+=cur.execute(f\"SELECT COUNT(*) FROM {t} WHERE {col} LIKE ?\",('%'+C+'%',)).fetchone()[0]\n        if hits:\n            for s,r in reps:\n                cur.execute(f\"UPDATE {t} SET {col}=replace({col},?,?)\",(s,r))\n            n+=cur.execute(f\"SELECT COUNT(*) FROM {t} WHERE {col} LIKE ? OR {col} LIKE ?\",('%'+A+'%','%'+C+'%')).fetchone()[0]\n    if n: report[t]=n\ncon.commit()\n\n# purge stale pages: checkpoint WAL, vacuum, checkpoint again\ncur.execute('PRAGMA wal_checkpoint(TRUNCATE)')\ncon.isolation_level=None\ncur.execute('VACUUM')\ncur.execute('PRAGMA wal_checkpoint(TRUNCATE)')\n\n# verify residuals across every text column\nleft=0\nfor t in tables:\n    for col in [r[1] for r in cur.execute(f\"PRAGMA table_info({t})\") if (r[2] or '').upper()=='TEXT']:\n        for pat in ('%'+A+'%','%'+C+'%','%'+' '+B+' '+'%','%\"'+B+'\"%',\"%'\" +B+\"'%\",'`'+B+'`'):\n            c=cur.execute(f\"SELECT COUNT(*) FROM {t} WHERE {col} LIKE ?\",(pat,)).fetchone()[0]\n            if c: left+=c; print('residual',t,col,pat,c)\nidbad=cur.execute(\"SELECT COUNT(*) FROM part WHERE id LIKE '%REDACTED%'\").fetchone()[0]+cur.execute(\"SELECT COUNT(*) FROM event WHERE id LIKE '%REDACTED%'\").fetchone()[0]\nprint('tables updated:', report)\nprint('residual matches:', left, '| corrupted IDs:', idbad)\nprint('integrity:', cur.execute('PRAGMA integrity_check').fetchone()[0])\n\n# scrub the plain-text log too\nLOG='/home/agent/.local/share/opencode/log/opencode.log'\ntxt=open(LOG,encoding='utf-8',errors='replace').read()\nbefore=sum(txt.count(s) for s,_ in reps)\nfor s,r in reps: txt=txt.replace(s,r)\nopen(LOG,'w').write(txt)\nprint('log tokens scrubbed:', before)\ncon.close()\nPYEOF" action.permission=bash action.action=allow action.pattern=*
